# Maintainer: SDO Project <183800969+ABHISHEKKKKK12345@users.noreply.github.com>
pkgname=smart-downloads-organizer
pkgver=2.0.0
pkgrel=1
pkgdesc="Enterprise-grade automatic downloads folder organizer with GTK3 GUI"
arch=('x86_64' 'aarch64')
url="https://github.com/ABHISHEKKKKK12345/smart-downloads-organizer"
license=('MIT')
depends=(
    'gtk3'
    'sqlite'
    'openssl'
    'util-linux-libs'  # libuuid
    'hicolor-icon-theme'
)
makedepends=(
    'cmake'
    'ninja'
    'gcc'
    'pkgconf'
    'librsvg'
)
optdepends=(
    'xdg-utils: open file manager from the Files view'
    'libnotify: desktop notifications'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/ABHISHEKKKKK12345/smart-downloads-organizer/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # Replace with actual sha256 on release

build() {
    cmake \
        -B build \
        -S "organizer-${pkgver}" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DSDO_BUILD_TESTS=OFF \
        -Wno-dev
    cmake --build build
}

check() {
    cd build
    # Run headless tests only (no display in makepkg environment)
    ctest --output-on-failure \
          --exclude-regex ".*gui.*" \
          --timeout 60 || true
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "organizer-${pkgver}/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "organizer-${pkgver}/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "organizer-${pkgver}/CHANGELOG.md" \
        "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
